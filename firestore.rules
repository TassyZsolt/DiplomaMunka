rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Exercises (Seed public exercises or user's custom exercises)
    match /exercises/{exerciseId} {
      allow read: if request.auth != null && (
        resource.data.isCustom == false || 
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && 
        request.resource.data.isCustom == true &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && 
        resource.data.isCustom == true &&
        resource.data.userId == request.auth.uid;
    }

    // 3. Workout Sessions
    match /workoutSessions/{sessionId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // 4. Custom Workout Plans
    match /workoutPlans/{planId} {
      allow read: if request.auth != null && (
        resource.data.isCustom == false || 
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 5. Personal Records
    match /personalRecords/{recordId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // 6. Meals (Diet)
    match /meals/{mealId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // 7. Water tracking
    match /waterDrank/{waterId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
  }
}
